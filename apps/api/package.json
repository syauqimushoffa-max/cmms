{
  "name": "@pbs-cmms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "pnpm --filter @pbs-cmms/shared build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @pbs-cmms/shared build && tsc -p tsconfig.json --noEmit",
    "push:keys": "node -e \"const webpush=require('web-push'); console.log(JSON.stringify(webpush.generateVAPIDKeys(), null, 2))\"",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@pbs-cmms/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "multer": "^1.4.5-lts.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.7",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
